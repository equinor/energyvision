{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
    //"defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*",
      "!.vscode",
      "!.github",
      "!.husky",
      "!.devcontainer",
      "!sanity.types.ts",
      "!**/.sanity",
      "!**/packages/energyvision/**/*.css",
      "!**/tsconfig.*.json", // https://github.com/biomejs/biome/issues/1151
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/node_modules",
      "!**/dist",
      "!**/build"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "attributes": ["className"],
            "functions": ["tw", "tw.*", "twMerge"]
          }
        }
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noNoninteractiveElementToInteractiveRole": "off",
        "useValidAnchor": "off",
        "useButtonType": "off",
        "useValidAriaRole": "off",
        "useValidAriaValues": "off",
        "useMediaCaption": "off",
        "useKeyWithClickEvents": "off",
        "noNoninteractiveTabindex": "off",
        "useAriaPropsForRole": "off",
        "useSemanticElements": "warn"
      },
      "style": {
        "useTemplate": "off",
        "noUnusedTemplateLiteral": "off",
        "noParameterAssign": "off",
        "useNumberNamespace": "off",
        "useSelfClosingElements": "off",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSingleVarDeclarator": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error"
      },
      "correctness": { "noUnusedVariables": "warn" },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noExplicitAny": "off",
        "noArrayIndexKey": "warn",
        "noTsIgnore": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useArrowFunction": "off",
        "noImportantStyles": "warn"
      }
    },
    "includes": ["**", "**/*", "!**/node_modules", "!**/.next", "!**/dist"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "json": { "formatter": { "enabled": true } },
  "overrides": [
    {
      "includes": ["satellites.json"],
      "json": {
        "formatter": {
          "expand": "never",
          "trailingCommas": "none",
          "lineWidth": 320
        }
      }
    }
  ],
  "css": {
    "parser": { "cssModules": true, "tailwindDirectives": true }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
