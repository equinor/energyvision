# syntax=docker/dockerfile:1
# -------------------------------------------------------- #
# 1. Base system environment
# -------------------------------------------------------- #
FROM node:lts-alpine AS core-os
RUN apk update
RUN apk add --no-cache libc6-compat curl

# --- BASE IMAGE: Install global tools ---
FROM core-os AS base
# Set working directory
WORKDIR /app
ENV PNPM_HOME="/pnpm"
#ENV PATH="$PNPM_HOME:$PATH"
ENV PATH="$PNPM_HOME/bin:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# Corepack manages the pinned pnpm version dynamically
RUN corepack enable && corepack prepare pnpm@11.23.0 --activate
RUN pnpm add -g turbo


# --- STAGE 1: Prune the monorepo workspace ---
FROM base AS pruner
WORKDIR /app
COPY . .
RUN ls -la
RUN turbo prune energy-vision-web --docker


# --- STAGE 2: Install dependencies ---
FROM base AS installer
WORKDIR /app

# Copy lockfile and skeleton workspace files generated by turbo prune
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=pruner /app/out/json/ .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile



# --- STAGE 3: Build the application ---
FROM base AS builder
WORKDIR /app   

COPY --from=pruner /app/out/full/ .
COPY --from=installer /app/ .
COPY turbo.json turbo.json

ARG ARG_SANITY_DATASET
ARG ARG_SANITY_PROJECT_ID
ARG ARG_ALGOLIA_APP_ID
ARG ARG_ARCHIVE_CONTENT_LINK
ARG ARG_FRIENDLY_CAPTCHA_SITEKEY
ARG ARG_DEPLOYMENT_ID
ARG ARG_OPTIMIZED_SANITY_FETCH

ENV NEXT_PUBLIC_SANITY_DATASET=${ARG_SANITY_DATASET}
ENV NEXT_PUBLIC_SANITY_PROJECT_ID=${ARG_SANITY_PROJECT_ID}
ENV NEXT_PUBLIC_ALGOLIA_APP_ID=${ARG_ALGOLIA_APP_ID}
ENV NEXT_PUBLIC_ARCHIVE_CONTENT_LINK=${ARG_ARCHIVE_CONTENT_LINK}
ENV NEXT_PUBLIC_FRIENDLY_CAPTCHA_SITEKEY=${ARG_FRIENDLY_CAPTCHA_SITEKEY}
ENV NEXT_PUBLIC_OPTIMIZED_SANITY_FETCH=${ARG_OPTIMIZED_SANITY_FETCH}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_DEPLOYMENT_ID=${ARG_DEPLOYMENT_ID}

RUN --mount=type=secret,id=sanity_api_token \
    --mount=type=secret,id=next_public_algolia_search_api_key \
    --mount=type=secret,id=next_server_actions_encryption_key \
    sh -ec 'SANITY_API_TOKEN="$(cat /run/secrets/sanity_api_token)" NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY="$(cat /run/secrets/next_public_algolia_search_api_key)" NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="$(cat /run/secrets/next_server_actions_encryption_key)" turbo build --filter=energy-vision-web'

# -------------------------------------------------------- #
# 6. Runtime container
# -------------------------------------------------------- #
FROM core-os AS runner

ARG ARG_ENV
ARG ARG_NODE_ENV
ARG ARG_SANITY_DATASET
ARG ARG_ALGOLIA_APP_ID
ARG ARG_FRIENDLY_CAPTCHA_SITEKEY
ARG ARG_OPTIMIZED_SANITY_FETCH

ENV ENV=${ARG_ENV}
ENV NODE_ENV=${ARG_NODE_ENV}

ENV NEXT_PUBLIC_SANITY_DATASET=${ARG_SANITY_DATASET}
ENV NEXT_PUBLIC_ALGOLIA_APP_ID=${ARG_ALGOLIA_APP_ID}
ENV NEXT_PUBLIC_FRIENDLY_CAPTCHA_SITEKEY=${ARG_FRIENDLY_CAPTCHA_SITEKEY}
ENV NEXT_PUBLIC_OPTIMIZED_SANITY_FETCH=${ARG_OPTIMIZED_SANITY_FETCH}

ENV NEXT_TELEMETRY_DISABLED=1
ENV USER=nextjs
ENV UID=12345

RUN addgroup -S "$USER" && adduser -S --uid "$UID" "$USER" && apk add --no-cache tini

COPY --from=builder /app/web/public ./public
COPY --from=builder  --chown="$USER":"$USER" /app/web/.next/standalone/web ./
COPY --from=builder  --chown="$USER":"$USER" /app/web/.next/static ./.next/static
# /app/apps/web path?

USER "$UID"
EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
#CMD ["node", "apps/web/server.js"] P
CMD ["node", "server.js"]
